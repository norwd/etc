root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true

[*.{json,json5}]
indent_size  = 4
indent_style = space

[*.{yml,yaml}]
indent_size  = 2
indent_style = space

[Makefile]
indent_size  = 8
indent_style = tab

[*.{sh,bash,bashrc,zsh,zshenv,zprofile,zshrc,zlogin,zlogout,zunit}]
indent_size  = 4
indent_style = tab
