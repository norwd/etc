[user]
	name = Y. Meyer-Norwood

[credential]
	helper =
	helper = git-credential-manager

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[help]
	autocorrect = 5

[push]
	rebase = false
	autoSetupRemote = true

[include]
	path = ./config.d/signingkey ; git config --file ~/.config/git/config.d/signingkey user.signingkey <gpg-key-id>

[include]
	path = ./config.d/github

[include]
	path = ./config.d/codeberg

[include]
	path = ./config.d/aliases
