[user]
	name = Y. Meyer-Norwood
	email = 106889957+norwd@users.noreply.github.com

# Set `user.signingkey` in `signingkey.gitconfig`
# ```shell
# git config --file ~/.config/git/signingkey.gitconfig user.signingkey <gpg-key-id>
# ```
[include]
	path = ~/.config/git/signingkey.gitconfig

[credential]
	helper =
	helper = git-credential-manager

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[help]
	autocorrect = 5

[push]
	rebase = false
	autoSetupRemote = true

# See also
# * https://github.com/odomojuli/regextokens
# * https://gist.github.com/magnetikonline/073afe7909ffdd6f10ef06a00bc3bc88
# * https://github.blog/changelog/2021-03-31-authentication-token-format-updates-are-generally-available
[filter "github_secrets"]
	clean = sed -e 's/gh[pousr]_[A-Za-z0-9_]\\+/xxxxx/g'
	smudge = cat

[alias]
	yolo = !git commit --no-gpg-sign --no-signoff --all --message \"$(curl --silent programmingexcuses.com | pandoc --from=html --to=plain)\"
