filetype plugin on
filetype indent on

set runtimepath^=$XDG_CONFIG_HOME/vim
set runtimepath+=$XDG_DATA_HOME/vim
set runtimepath+=$XDG_CONFIG_HOME/vim/after
set packpath^=$XDG_DATA_HOME/vim,$XDG_CONFIG_HOME/vim
set packpath+=$XDG_CONFIG_HOME/vim/after,$XDG_DATA_HOME/vim/after
set nocompatible
set noerrorbells
set novisualbell
set belloff=all
set ruler
set ignorecase
set smartcase
set hlsearch
set nobackup
set nowb
set noswapfile
set noshowmatch
set mouse=a
set viminfofile=NONE
set number
set incsearch
set hlsearch
set backspace=indent,eol,start
set whichwrap+=b,s,h,l,<,>,[,]
set wildmenu
set scrolloff=3
set title
set showcmd
set showmode
set cursorline
set spell
set spelllang=en_gb
set dictionary+=/usr/share/dict/words
"set colorcolumn=80

syntax enable

set background=dark
silent! colorscheme gruvbox8

if has("unix")
	let s:uname = system("uname -s")
	if s:uname == "Darwin"
		let isDark = system("osascript -e 'tell application \"System Events\" to tell appearance preferences to get dark mode'")
		if isDark != 'true'
			set background=light
			silent! colorscheme gruvbox8
		endif
	endif
endif

