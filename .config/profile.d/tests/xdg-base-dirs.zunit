@test 'Test WGETRC' {
	load ~/.config/profile

	expected="${XDG_CONFIG_HOME}/wget/wgetrc"
	actual="${WGETRC}"

	assert "${actual}" same_as "${expected}"
	assert "${actual}" is_not_empty
	assert "${actual}" is_file
	assert "${actual}" is_readable
	assert "${actual}" is_writable
}

@test 'Test GNUPGHOME' {
