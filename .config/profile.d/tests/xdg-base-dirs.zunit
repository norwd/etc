	assert "${actual}" same_as "${expected}"
	assert "${actual}" is_not_empty
	assert "${actual}" is_dir
}

@test 'Test PYTHON_HISTORY' {
	load ~/.config/profile

	expected="${XDG_STATE_HOME}/python_history"
	actual="${PYTHON_HISTORY}"

	assert "${actual}" same_as "${expected}"
	assert "${actual}" is_not_empty

	pass 'History files are not tracked'
	assert "${actual}" is_file
	assert "${actual}" is_readable
	assert "${actual}" is_writable
}

@test 'Test PYTHONPYCACHEPREFIX' {
