@test 'Test XDG_CONFIG_HOME' {
	load ~/.config/profile

	expected="${HOME}/.config"
	actual="${XDG_CONFIG_HOME}"

	assert "${actual}" same_as "${expected}"
	assert "${actual}" is_not_empty
	assert "${actual}" is_dir
}

@test 'Test XDG_CACHE_HOME' {
	load ~/.config/profile

	expected="${HOME}/.cache"
	actual="${XDG_CACHE_HOME}"

	assert "${actual}" same_as "${expected}"
	assert "${actual}" is_not_empty
	assert "${actual}" is_dir
}

@test 'Test XDG_DATA_HOME' {
	load ~/.config/profile

	expected="${HOME}/.local/share"
	actual="${XDG_DATA_HOME}"

	assert "${actual}" same_as "${expected}"
	assert "${actual}" is_not_empty
	assert "${actual}" is_dir
}

