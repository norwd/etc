#!/usr/bin/env zunit

@test 'Test GOPATH' {
	load ~/.config/profile

	assert "${XDG_DATA_HOME}" is_dir
	assert "${GOPATH}" is_dir
	assert "${GOPATH}" same_as "${XDG_DATA_HOME}/go"

	assert "${GOPATH}/bin" is_dir
	# shellcheck disable=SC2086 # Double quote to prevent globbing and word splitting.
	assert "${GOPATH}/bin" in ${path}
}

@test 'Test GOMODCACHE' {
	load ~/.config/profile

	assert "${XDG_CACHE_HOME}" is_dir
	assert "${GOMODCACHE}" is_dir
	assert "${GOMODCACHE}" same_as "${XDG_CACHE_HOME}/go/mod"
}
