@test 'Test XDG_BIN_HOME' {
	load ~/.config/profile

	assert "${XDG_BIN_HOME}" same_as "${HOME}/.local/bin"
	assert "${XDG_BIN_HOME}" is_dir
	# shellcheck disable=SC2086 # Double quote to prevent globbing and word splitting.
	assert "${XDG_BIN_HOME}" in ${path}
}
