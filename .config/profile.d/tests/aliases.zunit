#!/usr/bin/env zunit

@test 'Test ALIASES option' {
	assert "${options[aliases]}" same_as "on"
}

@test 'Test dotfiles alias' {
	load ~/.config/profile.d/020-aliases.sh

	assert "$(whence dotfiles)" same_as '/usr/bin/git --git-dir="${HOME}/etc/" --work-tree="${HOME}"'
}

@test 'Test grep alias' {
	load ~/.config/profile.d/020-aliases.sh

	assert "$(whence grep)" same_as 'grep --color=auto'
}

@test 'Test ls alias' {
	load ~/.config/profile.d/020-aliases.sh

	assert "$(whence ls)" same_as 'ls -F --color=auto'
}

@test 'Test ll alias' {
	load ~/.config/profile.d/020-aliases.sh

	assert "$(whence ll)" same_as 'ls -l'
}

@test 'Test la alias' {
	load ~/.config/profile.d/020-aliases.sh

	assert "$(whence la)" same_as 'll -A'
}

@test 'Test cat alias' {
	load ~/.config/profile.d/020-aliases.sh

	if [ -x "$(command -v bat)" ]
	then
		assert "$(whence cat)" same_as "bat"
	else
		assert "$(whence cat)" same_as "$(command -v cat)"
	fi
}

@test 'Test man alias' {
	load ~/.config/profile.d/020-aliases.sh

	if [ -x "$(command -v batman)" ]
	then
		assert "$(whence man)" same_as "batman"
	else
		assert "$(whence man)" same_as "$(command -v man)"
	fi
}

@test 'Test find alias' {
	load ~/.config/profile.d/020-aliases.sh

	if [ -x "$(command -v bfs)" ]
	then
		assert "$(whence find)" same_as "bfs"
	else
		assert "$(whence find)" same_as "$(command -v find)"
	fi
}

@test 'Test htop alias' {
	load ~/.config/profile.d/020-aliases.sh

	if [ -x "$(command -v btop)" ]
	then
		assert "$(whence htop)" same_as "btop"
	else
		assert "$(whence htop)" same_as "$(command -v htop)"
	fi
}

@test 'Test neofetch alias' {
	load ~/.config/profile.d/020-aliases.sh

	if [ -x "$(command -v fastfetch)" ]
	then
		assert "$(whence neofetch)" same_as "fastfetch"
	else
		assert "$(whence neofetch)" same_as "$(command -v neofetch)"
	fi
}
