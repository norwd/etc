@test 'Test neofetch is aliased to fastfetch if it exists' {
	load ~/.config/profile

	if [[ ! -x "$(command -v fastfetch)" ]]
	then
		skip "fastfetch is not installed: $(which fastfetch)"
	fi

	assert "$(whence neofetch)" same_as "fastfetch --config neofetch.jsonc"
	assert "$(which neofetch)" same_as 'neofetch: aliased to fastfetch --config neofetch.jsonc'
	assert "$(command -v neofetch)" same_as "alias neofetch='fastfetch --config neofetch.jsonc'"
}

@test 'Test neofetch is not aliased when fastfetch is not installed' {
	load ~/.config/profile

	if [[ -x "$(command -v fastfetch)" ]]
	then
		skip "fastfetch is installed: $(which fastfetch)"
	fi

	assert "$(whence neofetch)" same_as "$(command -v neofetch)"
}
