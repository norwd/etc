@test 'Test ALIASES option' {
	assert "${options[aliases]}" same_as "on"
}

@test 'Test dotfiles alias' {
	load ~/.config/profile

	assert "$(whence dotfiles)" same_as '/usr/bin/git --git-dir="${HOME}/etc/" --work-tree="${HOME}"'
	assert "$(which dotfiles)" same_as 'dotfiles: aliased to /usr/bin/git --git-dir="${HOME}/etc/" --work-tree="${HOME}"'
	assert "$(command -v dotfiles)" same_as "alias dotfiles='/usr/bin/git --git-dir=\"\${HOME}/etc/\" --work-tree=\"\${HOME}\"'"
	assert "$(command -v dotfiles)" same_as 'alias dotfiles='"'"'/usr/bin/git --git-dir="${HOME}/etc/" --work-tree="${HOME}"'"'"''
}

@test 'Test grep alias enables colour when ug is not installed' {
	if [[ -x "$(command -v ug)" ]]
	then
		skip "ug is installed: $(which ug)"
	fi

	load ~/.config/profile

	assert "$(whence grep)" same_as 'grep --color=auto'
	assert "$(which grep)" same_as 'grep: aliased to grep --color=auto'
	assert "$(command -v grep)" same_as "alias grep='grep --color=auto'"
}

@test 'Test ls alias' {
	load ~/.config/profile

	assert "$(whence ls)" same_as 'ls -F --color=auto'
	assert "$(which ls)" same_as 'ls: aliased to ls -F --color=auto'
	assert "$(command -v ls)" same_as "alias ls='ls -F --color=auto'"
}

@test 'Test ll alias' {
	load ~/.config/profile

	assert "$(whence ll)" same_as 'ls -l'
	assert "$(which ll)" same_as 'll: aliased to ls -l'
	assert "$(command -v ll)" same_as "alias ll='ls -l'"
}

@test 'Test la alias' {
	load ~/.config/profile

	assert "$(whence la)" same_as 'll -A'
	assert "$(which la)" same_as 'la: aliased to ll -A'
	assert "$(command -v la)" same_as "alias la='ll -A'"
}

@test 'Test cat is aliased to bat if it exists' {
	load ~/.config/profile

	if [[ ! -x "$(command -v bat)" ]]
	then
		skip "bat is not installed: $(which bat)"
	fi

	assert "$(whence cat)" same_as "bat"
	assert "$(which cat)" same_as 'cat: aliased to bat'
	assert "$(command -v cat)" same_as "alias cat='bat'"
}

@test 'Test cat is not aliased when bat is not installed' {
	load ~/.config/profile

	if [[ -x "$(command -v bat)" ]]
	then
		skip "bat is installed: $(which bat)"
	fi

	assert "$(which cat)" same_as "$(whence cat)"
	assert "$(which cat)" same_as "$(command -v cat)"
	assert "$(whence cat)" same_as "$(command -v cat)"
}

@test 'Test man is aliased to batman if it exists' {
	load ~/.config/profile

	if [[ ! -x "$(command -v batman)" ]]
	then
		skip "batman is not installed: $(which batman)"
	fi

	assert "$(whence man)" same_as "batman"
	assert "$(which man)" same_as 'man: aliased to batman'
	assert "$(command -v man)" same_as "alias man='batman'"
}

@test 'Test man is not aliased when batman is not installed' {
	load ~/.config/profile

	if [[ -x "$(command -v batman)" ]]
	then
		skip "batman is installed: $(which batman)"
	fi

	assert "$(which man)" same_as "$(whence man)"
	assert "$(which man)" same_as "$(command -v man)"
	assert "$(whence man)" same_as "$(command -v man)"
}

