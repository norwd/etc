#!/usr/bin/env zunit

@test 'Test PATH is not changed when ruby is not installed' {
	if [[ -x "$(command -v ruby)" ]]
	then
		# Fake PATH to hide Ruby
		PATH="/fake/${RANDOM}/path/${RANDOM}/to/${RANDOM}/bin"
	fi

	oldPath="${PATH}"

	load ~/.config/profile.d/050-gempaths.sh

	assert "${oldPath}" same_as "${PATH}"
}

@test 'Test PATH is not changed when gem is not installed' {
	if [[ -x "$(command -v gem)" ]]
	then
		# Fake PATH to hide Gem
		PATH="/fake/${RANDOM}/path/${RANDOM}/to/${RANDOM}/bin"
	fi

	oldPath="${PATH}"

	load ~/.config/profile.d/050-gempaths.sh

	assert "${oldPath}" same_as "${PATH}"
}

@test 'Test Ruby Gem User Dir is in XDG_DATA_HOME if ruby and gem are installed' {
	if [[ ! -x "$(command -v ruby)" ]]
	then
		skip 'Ruby is not installed'
	fi

	if [[ ! -x "$(command -v gem)" ]]
	then
		skip 'Gem is not installed'
	fi

	load ~/.config/profile.d/050-gempaths.sh

	_ruby_gem_user_dir="$(ruby -r rubygems -e 'puts Gem.user_dir')"

	assert "${_ruby_gem_user_dir}" is_not_empty
	assert "${_ruby_gem_user_dir}" matches "${XDG_DATA_HOME}/gem/ruby/[0-9]+.[0-9]+.[0-9]+"
}

@test 'Test Ruby Gem User Bin Dir is on path if it exists and is a directory' {
	if [[ ! -x "$(command -v ruby)" ]]
	then
		skip 'Ruby is not installed'
	fi

	if [[ ! -x "$(command -v gem)" ]]
	then
		skip 'Gem is not installed'
	fi

	load ~/.config/profile.d/050-gempaths.sh

	_ruby_gem_user_dir="$(ruby -r rubygems -e 'puts Gem.user_dir')"

	if [[ -d "${_ruby_gem_user_dir}" ]]
	then
		# shellcheck disable=SC2086 # Double quote to prevent globbing and word splitting.
		assert "${_ruby_gem_user_dir}/bin" in ${path}
	else
		skip 'Ruby gem user directory does not exist'
	fi
}
