@test 'Test Ruby Gem User Bin Dir' {
	if [[ ! -x "$(command -v ruby)" ]]
	then
		skip 'Ruby is not installed'
	fi

	if [[ ! -x "$(command -v gem)" ]]
	then
		skip 'Gem is not installed'
	fi

	run gem install github-markup --user-install

	load ~/.config/profile

	_ruby_gem_user_dir_bin="$(ruby -r rubygems -e 'puts Gem.user_dir')/bin"

	assert "${_ruby_gem_user_dir_bin}" is_dir
	# shellcheck disable=SC2086 # Double quote to prevent globbing and word splitting.
	assert "${_ruby_gem_user_dir_bin}" in ${path}
}
