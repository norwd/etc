# This directory only contains zsh files, so don't fuss about POSIX strictness

disable=SC2016 # (info): Expressions don't expand in single quotes, use double quotes for that.
disable=SC2154 # (warning): options is referenced but not assigned.
disable=SC3001 # (warning): In POSIX sh, process substitution is undefined.
disable=SC3010 # (warning): In POSIX sh, [[ ]] is undefined.
disable=SC3014 # (warning): In POSIX sh, == in place of = is undefined.
disable=SC3030 # (warning): In POSIX sh, arrays are undefined.
disable=SC3033 # (warning): In POSIX sh, naming functions outside [a-zA-Z_][a-zA-Z0-9_]* is undefined.
disable=SC3043 # (warning): In POSIX sh, 'local' is undefined.
disable=SC3045 # (warning): In POSIX sh, read -q is undefined.
disable=SC3046 # (warning): In POSIX sh, 'source' in place of '.' is undefined.
disable=SC3051 # (warning): In POSIX sh, 'source' in place of '.' is undefined.
disable=SC3054 # (warning): In POSIX sh, array references are undefined.
