@test 'Test ZDOTDIR/* is executable' {
	for script in $(find "${ZDOTDIR}" -name '.z*')
	do
		assert "${script}" is_executable
	done
}

@test 'Test *.zsh is executable' {
	for script in $(find "${ZDOTDIR}" -name '*.zsh')
	do
		assert "${script}" is_executable
	done
}

@test 'Test *.zunit is executable' {
	for script in $(find "${ZDOTDIR}" -name '*.zunit') $(find "${XDG_CONFIG_HOME}" -name '*.zunit')
	do
		assert "${script}" is_executable
	done
}
